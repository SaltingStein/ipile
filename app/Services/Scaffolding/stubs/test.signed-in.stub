<?php

namespace Tests\Feature;

use App\Models\User;
use Illuminate\Foundation\Testing\RefreshDatabase;
use Inertia\Testing\AssertableInertia as Assert;
use Tests\TestCase;

class {{ class }}PageTest extends TestCase
{
    use RefreshDatabase;

    public function test_guests_are_sent_to_sign_in(): void
    {
        $this->get(route('{{ routeName }}'))->assertRedirect(route('login'));
    }

    public function test_signed_in_users_can_open_the_page(): void
    {
        $this->actingAs(User::factory()->create())->get(route('{{ routeName }}'))->assertOk()
            ->assertInertia(fn (Assert $page) => $page->component('{{ class }}'));
    }
}
