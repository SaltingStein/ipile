<?php

namespace Tests\Feature\Security\Signals;

use {{ namespacedClass }};
use App\Services\Security\SecurityEventDefinition;
use App\Services\Security\Signals\SignalContext;
use Illuminate\Foundation\Testing\RefreshDatabase;
use Tests\TestCase;

class {{ class }}Test extends TestCase
{
    use RefreshDatabase;

    public function test_it_scores_nothing_for_events_it_is_not_about(): void
    {
        $signal = new {{ class }};

        $result = $signal->evaluate($this->contextFor('test.unrelated'));

        $this->assertSame(0.0, $result->score);
        $this->assertSame('{{ key }}', $signal->key());
    }

    /**
     * Build what Aegis gives the signal for one event. Add tests for the events it should score.
     *
     * @param  array<string, scalar|null>  $context
     */
    private function contextFor(string $type, array $context = []): SignalContext
    {
        return new SignalContext(
            new SecurityEventDefinition($type, 'testing', 'Test event', 'Used by tests.'),
            null,
            '127.0.0.1',
            null,
            null,
            now(),
            null,
            $context,
        );
    }
}
