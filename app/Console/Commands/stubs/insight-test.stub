<?php

namespace Tests\Feature;

use App\Ai\Insights\{{ name }};
{{ teamImport }}use App\Models\User;
use App\Services\Assistant\AssistantSettings;
use Illuminate\Foundation\Testing\RefreshDatabase;
use Laravel\Ai\Tools\Request;
use Spatie\Permission\Models\Permission;
use Tests\TestCase;

class {{ name }}InsightTest extends TestCase
{
    use RefreshDatabase;

    public function test_insight_cannot_run_before_an_administrator_allows_it(): void
    {
        $result = (new {{ name }}($this->allowedPerson()))->handle(new Request([]));

        $this->assertSame('That insight is not available to this person. Do not guess it.', $result);
    }

    public function test_allowed_staff_get_aggregates_for_the_period(): void
    {
        $person = $this->allowedPerson();
        // Assistant on (with a model chosen), the Analytics staff mode on and this insight ticked in Admin → Site assistant.
        app(AssistantSettings::class)->update(true, 'openai', [], 50, staffModes: ['analytics']);
        app(AssistantSettings::class)->updateInsights(['{{ key }}']);

        $result = json_decode((string) (new {{ name }}($person))->handle(new Request([])), true);

        $this->assertSame('{{ key }}', $result['insight']);
        $this->assertSame(30, $result['period_days']);
        $this->assertFalse($result['truncated']);
    }

    private function allowedPerson(): User
    {
        $person = User::factory()->create();
        $person->givePermissionTo(array_map(fn (string $permission) => Permission::findOrCreate($permission), [{{ permissions }}]));

{{ teamSetup }}        return $person;
    }
}
